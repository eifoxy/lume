<Window x:Class="Lume.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Lume" Title="Lume · TC420 · 0.7" Width="1420" Height="1000" MinWidth="940" MinHeight="650" Background="#0D1518" Foreground="#E4ECEB" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111D20" BorderBrush="#243135" BorderThickness="0,0,1,0">
   <DockPanel Margin="22,28,18,22">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="#75DFBD"><TextBlock Text="◒" FontSize="25" Foreground="#10251F" HorizontalAlignment="Center" Margin="0,-2,0,0"/></Border><TextBlock Text="lume" FontWeight="SemiBold" FontSize="28" Margin="10,-4,0,0"/></StackPanel>
     <TextBlock Text="{local:Tr Key='LUZ NO SEU RITMO'}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,12,0,36"/>
     <TextBlock Text="{local:Tr Key='Idioma'}" Foreground="{StaticResource Muted}" FontSize="11"/>
     <ComboBox x:Name="LanguageMenu" SelectionChanged="LanguageChanged" Margin="0,6,0,18" FontSize="11"><ComboBoxItem Tag="auto" Content="{local:Tr Key='Automático (dispositivo)'}"/><ComboBoxItem Tag="pt-BR" Content="Português (Brasil)"/><ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="es" Content="Español"/></ComboBox>
     <TextBlock Text="{local:Tr Key='SEUS PERFIS'}" FontSize="10" Foreground="{StaticResource Muted}" Margin="12,0,0,10"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Button Content="{local:Tr Key='+  Novo perfil'}" Click="NewProfile" Margin="0,0,0,10"/>
     <Button Content="{local:Tr Key='Importar Pled / backup'}" Click="Import" Margin="0,0,0,20" Background="#19272B"/>
     <Border Height="1" Background="#2A373A" Margin="0,0,0,18"/>
     <TextBlock Text="{local:Tr Key='TC420 / Pled · USB e Wi-Fi'}" FontSize="12"/>
     <TextBlock Text="{local:Tr Key='Edição local · v0.7'}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
     <TextBlock Text="{local:Tr Key='Integração física em validação'}" Foreground="#CDBB8D" FontSize="10" Margin="0,8,0,0"/>
    </StackPanel>
    <ListBox x:Name="Profiles" Background="Transparent" BorderThickness="0" SelectionChanged="SelectProfile"/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="32,26,30,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,20">
    <StackPanel Margin="0,0,0,16"><TextBlock Text="{local:Tr Key='Seu aquário, em equilíbrio.'}" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Connection" Text="{local:Tr Key='Editor offline · conecte a controladora por USB'}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
    <WrapPanel VerticalAlignment="Center">
     <Button x:Name="DetectButton" Content="{local:Tr Key='Buscar USB'}" Click="Detect" Margin="0,0,8,8"/>
     <Button x:Name="WifiButton" Content="{local:Tr Key='Conectar por Wi-Fi'}" Click="OpenWifi" Margin="0,0,8,8"/>
     <Button x:Name="SyncButton" Content="{local:Tr Key='Sincronizar horário'}" Click="Sync" IsEnabled="False" ToolTip="{local:Tr Key='Ajusta a data e o horário da controladora pela hora local deste PC. Primeiro, busque por USB ou conecte por Wi-Fi.'}"/>
     <Button Content="{local:Tr Key='Salvar backup'}" Click="Backup"/>
     <Button Content="{local:Tr Key='Enviar ao celular por QR'}" Click="ShareQr"/>
     <Button x:Name="UploadButton" Content="{local:Tr Key='Enviar à TC420  ↗'}" Click="Upload" Background="#77DFBF" Foreground="#102820" Margin="0,0,0,8" IsEnabled="False"/>
    </WrapPanel>
   </StackPanel>
   <ScrollViewer x:Name="Workspace" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,10,0">
     <DockPanel Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="{local:Tr Key='Renomear'}" Click="Rename" Padding="12,8"/><Button Content="{local:Tr Key='Duplicar'}" Click="Duplicate" Padding="12,8"/><Button Content="{local:Tr Key='Exportar .lmf'}" Click="Export" Padding="12,8" Margin="0"/></StackPanel>
      <StackPanel><TextBlock x:Name="ProfileTitle" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{local:Tr Key='PROGRAMAÇÃO DIÁRIA · 5 CANAIS · 48 HORÁRIOS'}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/></StackPanel>
     </DockPanel>
     <Border CornerRadius="14" Background="#152125" BorderBrush="#29373B" BorderThickness="1" Padding="22,18,22,14">
      <StackPanel>
       <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{local:Tr Key='Reorganizar canais'}" Click="ReorderChannels" Padding="12,7"/><Button Content="{local:Tr Key='↶  Desfazer'}" Click="Undo" Padding="12,7"/><Button Content="{local:Tr Key='Criar ciclo suave'}" Click="Wizard" Padding="12,7" Margin="0"/></StackPanel><StackPanel><TextBlock Text="{local:Tr Key='Seu dia de luz'}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{local:Tr Key='Passe o mouse para ler os valores. Clique para explorar um horário.'}" Foreground="#AFBFBE" FontSize="11" Margin="0,5,0,0"/></StackPanel></DockPanel>
       <WrapPanel Margin="0,16,0,0"><CheckBox x:Name="DrawMode" Content="{local:Tr Key='Desenhar curva'}" Checked="ChartOptions" Unchecked="ChartOptions" Margin="0,0,20,8"/><CheckBox x:Name="SoloMode" Content="{local:Tr Key='Isolar canal selecionado'}" Checked="ChartOptions" Unchecked="ChartOptions" Margin="0,0,20,8"/><Button x:Name="ExpandChart" Content="{local:Tr Key='⛶  Ampliar curva'}" Click="ExpandCurve" Padding="10,5" FontSize="11" Margin="0,0,0,8"/></WrapPanel>
       <StackPanel Orientation="Horizontal" x:Name="Legend" Margin="0,4,0,4"/>
       <Canvas x:Name="Chart" Height="300" Margin="0,12,0,4" Background="Transparent" SizeChanged="ChartSized" MouseLeftButtonDown="ChartDown" MouseMove="ChartMove" MouseLeave="ChartLeave" MouseLeftButtonUp="ChartUp" LostMouseCapture="ChartLost"/>
       <Border Background="#0F1B1F" CornerRadius="7" Padding="12,9" Margin="0,8,0,0"><TextBlock x:Name="ChartReading" Text="{local:Tr Key='Mova o mouse sobre a curva para consultar os cinco canais.'}" FontSize="12" Foreground="#C0D3CD" TextWrapping="Wrap"/></Border>
      </StackPanel>
     </Border>
     <Border CornerRadius="12" Background="#152125" Padding="20,16" Margin="0,16,0,0">
      <StackPanel>
       <DockPanel><TextBlock Text="{local:Tr Key='Aquário virtual'}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{local:Tr Key='PRÉVIA LOCAL'}" Foreground="#77DFBF" HorizontalAlignment="Right" FontSize="10" VerticalAlignment="Center"/></DockPanel>
       <TextBlock Text="{local:Tr Key='Corais se abrem com a luz; peixes-palhaço nadam pelo recife.'}" Foreground="#AFBFBE" FontSize="11" Margin="0,6,0,0"/>
       <CheckBox x:Name="AnimateReef" Content="{local:Tr Key='Animar recife'}" IsChecked="True" Checked="ReefMotionChanged" Unchecked="ReefMotionChanged" Margin="0,12,0,0"/>
       <local:LedSimulation x:Name="Tank" Height="320" Margin="0,10,0,0"/>
       <UniformGrid x:Name="LedReadings" Columns="5" Margin="0,0,0,8"/>
       <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Button x:Name="SimButton" Content="▶" Click="Simulate" Width="44" Padding="8" ToolTip="{local:Tr Key='Reproduzir um dia de iluminação'}"/><Slider x:Name="Preview" Grid.Column="1" Maximum="47.999" Value="24" IsSnapToTickEnabled="False" ValueChanged="PreviewChanged" Margin="6,7,14,7"/><TextBlock x:Name="PreviewTime" Grid.Column="2" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
       <WrapPanel Margin="0,8,0,0"><Button Content="00h" Tag="0" Click="JumpTime" Padding="12,6"/><Button Content="06h" Tag="12" Click="JumpTime" Padding="12,6"/><Button Content="12h" Tag="24" Click="JumpTime" Padding="12,6"/><Button Content="18h" Tag="36" Click="JumpTime" Padding="12,6"/><TextBlock Text="{local:Tr Key='Um dia em'}" VerticalAlignment="Center" Margin="12,0,8,0"/><ComboBox x:Name="SimSpeed" Width="100" MinWidth="0" SelectedIndex="1" SelectionChanged="SpeedChanged"><ComboBoxItem Content="{local:Tr Key='12 segundos'}"/><ComboBoxItem Content="{local:Tr Key='36 segundos'}"/><ComboBoxItem Content="{local:Tr Key='72 segundos'}"/></ComboBox></WrapPanel>
       <TextBlock Text="{local:Tr Key='Animação ilustrativa · a abertura dos corais não prevê resposta biológica, PAR ou espectro.'}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap"/>
       <Expander Header="Controlar o equipamento" Foreground="#C0D3CD" Margin="0,14,0,0"><WrapPanel Margin="0,12,0,0"><Button Content="{local:Tr Key='Aplicar este instante aos LEDs'}" Click="Manual" Padding="12,8" x:Name="ManualButton" IsEnabled="False"/><Button Content="{local:Tr Key='Retomar programa'}" Click="Resume" Padding="12,8" x:Name="ResumeButton" IsEnabled="False"/></WrapPanel></Expander>
      </StackPanel>
     </Border>
     <DockPanel Margin="0,20,0,12"><TextBlock Text="{local:Tr Key='Ajuste por canal'}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="EditingTime" Text="{local:Tr Key='Editar ponto de 12:00'}" Foreground="#B6CEC5" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
     <UniformGrid x:Name="ChannelCards" Columns="5"/>
     <Expander x:Name="Precision" Header="{local:Tr Key='Tabela de horários · edição precisa'}" Foreground="#CFDFDA" Margin="0,22,0,16" IsExpanded="False">
      <StackPanel><TextBlock Text="{local:Tr Key='Selecione um horário para vê-lo no gráfico e no aquário. Digite de 0 a 100%; Enter confirma.'}" Foreground="#AFBFBE" FontSize="12" Margin="0,12" TextWrapping="Wrap"/>
       <DataGrid x:Name="Table" Height="384" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" Background="#111D22" Foreground="#D9E7E2" RowBackground="#152329" AlternatingRowBackground="#192A30" BorderBrush="#33494D" BorderThickness="1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#293F44" CellEditEnding="CellEdited" SelectedCellsChanged="TableSelected" RowHeight="36" ColumnHeaderHeight="56" HeadersVisibility="Column" SelectionUnit="Cell" SelectionMode="Single" FrozenColumnCount="1" FontSize="13" RowDetailsVisibilityMode="Collapsed">
        <DataGrid.Resources>
         <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#22383E"/><Setter Property="Foreground" Value="#F0F7F4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,10"/><Setter Property="BorderBrush" Value="#365057"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
         <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#D9E7E2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2E574C"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#7DE3BF"/><Setter Property="BorderThickness" Value="1"/></Trigger></Style.Triggers></Style>
         <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#D9E7E2"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#233D43"/></Trigger></Style.Triggers></Style>
        </DataGrid.Resources>
        <DataGrid.Columns><DataGridTextColumn Header="{local:Tr Key='Horário'}" Binding="{Binding Time}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="CH1" Binding="{Binding C1, StringFormat={}{0}%}" Width="*"/><DataGridTextColumn Header="CH2" Binding="{Binding C2, StringFormat={}{0}%}" Width="*"/><DataGridTextColumn Header="CH3" Binding="{Binding C3, StringFormat={}{0}%}" Width="*"/><DataGridTextColumn Header="CH4" Binding="{Binding C4, StringFormat={}{0}%}" Width="*"/><DataGridTextColumn Header="CH5" Binding="{Binding C5, StringFormat={}{0}%}" Width="*"/></DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="{local:Tr Key='A programação salva continua em passos de 30 minutos. A simulação interpola os intervalos.'}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Expander>
    </StackPanel>
   </ScrollViewer>
   <DockPanel Grid.Row="2" Margin="0,16,0,0"><ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="140" Height="4" Maximum="100" Visibility="Collapsed"/><TextBlock x:Name="Status" Text="{local:Tr Key='Pronto para criar.'}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></DockPanel>
  </Grid>
 </Grid>
</Window>
